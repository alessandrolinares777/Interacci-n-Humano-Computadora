<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ListView android:id="@+id/lvMsgs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:stackFromBottom="true" android:transcriptMode="alwaysScroll" android:divider="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
        <EditText android:id="@+id/etMsg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Escribe un mensaje..." />
        <Button android:id="@+id/btnEnviar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enviar" />
    </LinearLayout>
</LinearLayout>
