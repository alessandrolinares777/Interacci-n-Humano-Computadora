<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/tvNombre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="#000" />
    <TextView android:id="@+id/tvInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="24dp" />
    <Button android:id="@+id/btnReportes" android:layout_width="match_parent" android:layout_height="64dp" android:text="Reportes comunitarios" android:backgroundTint="@color/verde_oscuro" />
    <Button android:id="@+id/btnAvisos" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:text="Avisos importantes" android:backgroundTint="@color/verde_oscuro" />
    <Button android:id="@+id/btnMensajes" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:text="Mensajes privados" android:backgroundTint="@color/verde_oscuro" />
</LinearLayout>
